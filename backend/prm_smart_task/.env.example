# Backend runtime
PORT=8080

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/prm_smart_task?sslmode=disable
DB_USERNAME=postgres
DB_PASSWORD=your-local-postgres-password

# JWT Security (minimum 32 characters)
JWT_SECRET=your-secret-key-with-minimum-32-characters
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# JPA/Hibernate Settings
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# Gmail SMTP (needed only for forgot-password email)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-sender@gmail.com
MAIL_PASSWORD=your-google-app-password
MAIL_FROM=your-sender@gmail.com

# Cloudinary (required for image uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
