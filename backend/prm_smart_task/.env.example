# Backend runtime
PORT=8080

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/prm_smart_task?sslmode=disable
DB_USERNAME=postgres
DB_PASSWORD=your-local-postgres-password

# JWT Security (minimum 32 characters)
JWT_SECRET=your-secret-key-with-minimum-32-characters
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Google OAuth Web application client ID (same ID used by Flutter)
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Required only when serving Flutter Web from a non-local origin
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:*,http://127.0.0.1,http://127.0.0.1:*,https://localhost,https://localhost:*,https://127.0.0.1,https://127.0.0.1:*

# JPA/Hibernate Settings
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# Mailjet email API (needed only for forgot-password email)
MJ_APIKEY_PUBLIC=your-mailjet-public-api-key
MJ_APIKEY_PRIVATE=your-mailjet-private-api-key
MAILJET_FROM_EMAIL=your-validated-sender@example.com
MAILJET_FROM_NAME=PRM Smart Task

# Cloudinary (required for image uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
