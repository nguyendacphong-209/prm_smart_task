# Backend runtime
PORT=8080

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://your-postgres-host:5432/your-database-name?sslmode=require
DB_USERNAME=your-database-user
DB_PASSWORD=your-strong-database-password

# JWT Security (minimum 32 characters)
JWT_SECRET=your-secret-key-with-minimum-32-characters
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Google OAuth Web application client ID (same ID used by Flutter)
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Required only when serving Flutter Web from a non-local origin
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:*,http://127.0.0.1,http://127.0.0.1:*,https://localhost,https://localhost:*,https://127.0.0.1,https://127.0.0.1:*

# JPA/Hibernate Settings
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
